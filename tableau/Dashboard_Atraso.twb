    <worksheet name='Taxa de atraso por dia da semana'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#f28e2b'>Taxa de atraso</run>
            <run fontalignment='1' fontcolor='#000000'> por</run>
            <run bold='true' fontalignment='1' fontcolor='#000000'> dia da semana</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_order_items (dwh.fact_order_items)+ (ecommerce_olist)' name='federated.1gpyloj1pumxwd1d5yx7x0m3tkso' />
          </datasources>
          <datasource-dependencies datasource='federated.1gpyloj1pumxwd1d5yx7x0m3tkso'>
            <column caption='Somente pedidos entregues' datatype='boolean' name='[Calculation_1069042002915639296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([order_delivered_customer_date (fact_deliveries)])' />
            </column>
            <column caption='Taxa de atraso confiável' datatype='real' default-format='p0.00%' name='[Calculation_1069042002935189517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IIF(&#13;&#10;        DATE([order_delivered_customer_date (fact_deliveries)])&#13;&#10;        &gt; DATE([order_estimated_delivery_date (fact_deliveries)]),&#13;&#10;        1, 0&#13;&#10;    )&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([order_id (fact_deliveries)])' />
            </column>
            <column caption='Dia da semana (compra)' datatype='string' name='[Calculation_1069042002983047184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [order_purchase_timestamp (fact_deliveries)])' />
              <aliases>
                <alias key='&quot;Friday&quot;' value='Sexta-Feira' />
                <alias key='&quot;Monday&quot;' value='Segunda-Feira' />
                <alias key='&quot;Saturday&quot;' value='Sábado' />
                <alias key='&quot;Sunday&quot;' value='Domingo' />
                <alias key='&quot;Thursday&quot;' value='Quinta-Feira' />
                <alias key='&quot;Tuesday&quot;' value='Terça-Feira' />
                <alias key='&quot;Wednesday&quot;' value='Quarta-Feira' />
              </aliases>
            </column>
            <column-instance column='[Calculation_1069042002915639296]' derivation='None' name='[none:Calculation_1069042002915639296:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1069042002983047184]' derivation='None' name='[none:Calculation_1069042002983047184:nk]' pivot='key' type='nominal' />
            <column caption='Order Delivered Customer Date (Fact Deliveries)' datatype='datetime' name='[order_delivered_customer_date (fact_deliveries)]' role='dimension' type='ordinal' />
            <column caption='Order Estimated Delivery Date (Fact Deliveries)' datatype='datetime' name='[order_estimated_delivery_date (fact_deliveries)]' role='dimension' type='ordinal' />
            <column caption='Order Id (Fact Deliveries)' datatype='string' name='[order_id (fact_deliveries)]' role='dimension' type='nominal' />
            <column caption='Order Purchase Timestamp (Fact Deliveries)' datatype='datetime' name='[order_purchase_timestamp (fact_deliveries)]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1069042002935189517]' derivation='User' name='[usr:Calculation_1069042002935189517:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
