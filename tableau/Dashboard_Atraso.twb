              <calculation class='tableau' formula='NOT ISNULL([order_delivered_customer_date (fact_deliveries)])' />
            </column>
            <column caption='Pedidos' datatype='integer' name='[Calculation_1069042002916122626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([order_id (fact_deliveries)])' />
            </column>
            <column caption='Pedidos atrasados' datatype='integer' name='[Calculation_1069042002917654534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [order_delivered_customer_date (fact_deliveries)]&#13;&#10;       &gt; [order_estimated_delivery_date (fact_deliveries)]&#13;&#10;    THEN [order_id (fact_deliveries)]&#13;&#10;    END&#13;&#10;)' />
