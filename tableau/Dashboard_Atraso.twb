    <worksheet name='Resumo do período'>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_order_items (dwh.fact_order_items)+ (ecommerce_olist)' name='federated.1gpyloj1pumxwd1d5yx7x0m3tkso' />
