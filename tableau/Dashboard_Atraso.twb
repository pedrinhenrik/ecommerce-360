            <column caption='Order Purchase Timestamp (Fact Deliveries)' datatype='datetime' name='[order_purchase_timestamp (fact_deliveries)]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_199284325334249472]' derivation='Month-Trunc' name='[tmn:Calculation_199284325334249472:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_199284325334347777]' derivation='Month-Trunc' name='[tmn:Calculation_199284325334347777:qk]' pivot='key' type='quantitative' />
