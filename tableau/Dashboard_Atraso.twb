            <column caption='Taxa de atraso confiável' datatype='real' default-format='p0.00%' name='[Calculation_1069042002935189517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IIF(&#13;&#10;        DATE([order_delivered_customer_date (fact_deliveries)])&#13;&#10;        &gt; DATE([order_estimated_delivery_date (fact_deliveries)]),&#13;&#10;        1, 0&#13;&#10;    )&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([order_id (fact_deliveries)])' />
            </column>
            <column caption='Início do período' datatype='datetime' name='[Calculation_199284325334249472]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// mês inicial dentro do que está filtrado&#13;&#10;DATETRUNC(&#13;&#10;  &apos;month&apos;,&#13;&#10;  { FIXED : MIN( DATE([order_purchase_timestamp (fact_deliveries)]) ) }&#13;&#10;)' />
            </column>
            <column caption='Fim do período' datatype='datetime' name='[Calculation_199284325334347777]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// mês final dentro do que está filtrado&#13;&#10;DATETRUNC(&#13;&#10;  &apos;month&apos;,&#13;&#10;  { FIXED : MAX( DATE([order_purchase_timestamp (fact_deliveries)]) ) }&#13;&#10;)' />
            </column>
            <column-instance column='[Calculation_1069042002915639296]' derivation='None' name='[none:Calculation_1069042002915639296:nk]' pivot='key' type='nominal' />
