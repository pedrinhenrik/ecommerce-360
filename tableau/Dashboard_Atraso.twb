      <aliases enabled='yes' />
      <column caption='Somente pedidos entregues' datatype='boolean' name='[Calculation_1069042002915639296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([order_delivered_customer_date (fact_deliveries)])' />
      </column>
      <column caption='Entrega após estimado?' datatype='integer' name='[Calculation_1069042002916003841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [order_id (fact_deliveries)] :&#13;&#10;    IF MAX([order_delivered_customer_date (fact_deliveries)])&#13;&#10;       &gt; MAX([order_estimated_delivery_date (fact_deliveries)])&#13;&#10;    THEN 1 ELSE 0 END&#13;&#10;}' />
      </column>
      <column caption='Pedidos' datatype='integer' name='[Calculation_1069042002916122626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id (fact_deliveries)])' />
      </column>
      <column caption='Pedidos atrasados' datatype='integer' name='[Calculation_1069042002917654534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [order_delivered_customer_date (fact_deliveries)]&#13;&#10;       &gt; [order_estimated_delivery_date (fact_deliveries)]&#13;&#10;    THEN [order_id (fact_deliveries)]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Taxa de atraso' datatype='real' name='[Calculation_1069042002919731207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1069042002917654534] / [Calculation_1069042002916122626]' />
      </column>
      <column caption='Dias de atraso do pedido' datatype='integer' name='[Calculation_1069042002931834891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([order_delivered_customer_date (fact_deliveries)])&#13;&#10;OR ISNULL([order_estimated_delivery_date (fact_deliveries)])&#13;&#10;THEN NULL&#13;&#10;ELSE&#13;&#10;    DATEDIFF(&#13;&#10;        &apos;day&apos;,&#13;&#10;        DATE([order_estimated_delivery_date (fact_deliveries)]),&#13;&#10;        DATE([order_delivered_customer_date (fact_deliveries)])&#13;&#10;    )&#13;&#10;END' />
      </column>
      <column caption='Dias de atraso sem negativo' datatype='real' name='[Calculation_1069042002932346892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    IIF(&#13;&#10;        DATEDIFF(&#13;&#10;            &apos;day&apos;,&#13;&#10;            DATE([order_estimated_delivery_date (fact_deliveries)]),&#13;&#10;            DATE([order_delivered_customer_date (fact_deliveries)])&#13;&#10;        ) &lt; 0,&#13;&#10;        0,&#13;&#10;        DATEDIFF(&#13;&#10;            &apos;day&apos;,&#13;&#10;            DATE([order_estimated_delivery_date (fact_deliveries)]),&#13;&#10;            DATE([order_delivered_customer_date (fact_deliveries)])&#13;&#10;        )&#13;&#10;    )&#13;&#10;)' />
      </column>
      <column caption='Taxa de atraso confiável' datatype='real' default-format='p0.00%' name='[Calculation_1069042002935189517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IIF(&#13;&#10;        DATE([order_delivered_customer_date (fact_deliveries)])&#13;&#10;        &gt; DATE([order_estimated_delivery_date (fact_deliveries)]),&#13;&#10;        1, 0&#13;&#10;    )&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([order_id (fact_deliveries)])' />
      </column>
      <column caption='Ciclo total (dias)' datatype='integer' name='[Calculation_1069042002979135502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(&#13;&#10;    ISNULL([order_purchase_timestamp (fact_deliveries)])&#13;&#10;    OR ISNULL([order_delivered_customer_date (fact_deliveries)]),&#13;&#10;    NULL,&#13;&#10;    DATEDIFF(&#13;&#10;        &apos;day&apos;,&#13;&#10;        DATETRUNC(&apos;day&apos;,[order_purchase_timestamp (fact_deliveries)]),&#13;&#10;        DATETRUNC(&apos;day&apos;,[order_delivered_customer_date (fact_deliveries)])&#13;&#10;    )&#13;&#10;)' />
      </column>
      <column caption='Atraso (dias)' datatype='integer' name='[Calculation_1069042002980900879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(&#13;&#10;    ISNULL([order_estimated_delivery_date (fact_deliveries)])&#13;&#10;    OR ISNULL([order_delivered_customer_date (fact_deliveries)]),&#13;&#10;    NULL,&#13;&#10;    IIF(&#13;&#10;        DATEDIFF(&#13;&#10;            &apos;day&apos;,&#13;&#10;            DATETRUNC(&apos;day&apos;,[order_estimated_delivery_date (fact_deliveries)]),&#13;&#10;            DATETRUNC(&apos;day&apos;,[order_delivered_customer_date (fact_deliveries)])&#13;&#10;        ) &lt; 0,&#13;&#10;        0,&#13;&#10;        DATEDIFF(&#13;&#10;            &apos;day&apos;,&#13;&#10;            DATETRUNC(&apos;day&apos;,[order_estimated_delivery_date (fact_deliveries)]),&#13;&#10;            DATETRUNC(&apos;day&apos;,[order_delivered_customer_date (fact_deliveries)])&#13;&#10;        )&#13;&#10;    )&#13;&#10;)' />
      </column>
      <column caption='Dia da semana (compra)' datatype='string' name='[Calculation_1069042002983047184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [order_purchase_timestamp (fact_deliveries)])' />
        <aliases>
          <alias key='&quot;Friday&quot;' value='Sexta-Feira' />
          <alias key='&quot;Monday&quot;' value='Segunda-Feira' />
          <alias key='&quot;Saturday&quot;' value='Sábado' />
          <alias key='&quot;Sunday&quot;' value='Domingo' />
          <alias key='&quot;Thursday&quot;' value='Quinta-Feira' />
          <alias key='&quot;Tuesday&quot;' value='Terça-Feira' />
          <alias key='&quot;Wednesday&quot;' value='Quarta-Feira' />
        </aliases>
      </column>
      <column caption='Ordem dia' datatype='integer' name='[Calculation_1069042002983100433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;, [order_purchase_timestamp (fact_deliveries)])' />
      </column>
      <column caption='Região (cliente)' datatype='string' name='[Calculation_1069042003000524818]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [customer_state]   // ou o nome do seu campo de UF do cliente&#13;&#10;WHEN &apos;AC&apos; THEN &apos;Norte&apos;&#13;&#10;WHEN &apos;AP&apos; THEN &apos;Norte&apos;&#13;&#10;WHEN &apos;AM&apos; THEN &apos;Norte&apos;&#13;&#10;WHEN &apos;PA&apos; THEN &apos;Norte&apos;&#13;&#10;WHEN &apos;RO&apos; THEN &apos;Norte&apos;&#13;&#10;WHEN &apos;RR&apos; THEN &apos;Norte&apos;&#13;&#10;WHEN &apos;TO&apos; THEN &apos;Norte&apos;&#13;&#10;&#13;&#10;WHEN &apos;AL&apos; THEN &apos;Nordeste&apos;&#13;&#10;WHEN &apos;BA&apos; THEN &apos;Nordeste&apos;&#13;&#10;WHEN &apos;CE&apos; THEN &apos;Nordeste&apos;&#13;&#10;WHEN &apos;MA&apos; THEN &apos;Nordeste&apos;&#13;&#10;WHEN &apos;PB&apos; THEN &apos;Nordeste&apos;&#13;&#10;WHEN &apos;PE&apos; THEN &apos;Nordeste&apos;&#13;&#10;WHEN &apos;PI&apos; THEN &apos;Nordeste&apos;&#13;&#10;WHEN &apos;RN&apos; THEN &apos;Nordeste&apos;&#13;&#10;WHEN &apos;SE&apos; THEN &apos;Nordeste&apos;&#13;&#10;&#13;&#10;WHEN &apos;ES&apos; THEN &apos;Sudeste&apos;&#13;&#10;WHEN &apos;MG&apos; THEN &apos;Sudeste&apos;&#13;&#10;WHEN &apos;RJ&apos; THEN &apos;Sudeste&apos;&#13;&#10;WHEN &apos;SP&apos; THEN &apos;Sudeste&apos;&#13;&#10;&#13;&#10;WHEN &apos;PR&apos; THEN &apos;Sul&apos;&#13;&#10;WHEN &apos;RS&apos; THEN &apos;Sul&apos;&#13;&#10;WHEN &apos;SC&apos; THEN &apos;Sul&apos;&#13;&#10;&#13;&#10;WHEN &apos;DF&apos; THEN &apos;Centro-Oeste&apos;&#13;&#10;WHEN &apos;GO&apos; THEN &apos;Centro-Oeste&apos;&#13;&#10;WHEN &apos;MT&apos; THEN &apos;Centro-Oeste&apos;&#13;&#10;WHEN &apos;MS&apos; THEN &apos;Centro-Oeste&apos;&#13;&#10;END' />
      </column>
      <column caption='Início do período' datatype='datetime' name='[Calculation_199284325334249472]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// mês inicial dentro do que está filtrado&#13;&#10;DATETRUNC(&#13;&#10;  &apos;month&apos;,&#13;&#10;  { FIXED : MIN( DATE([order_purchase_timestamp (fact_deliveries)]) ) }&#13;&#10;)' />
      </column>
      <column caption='Fim do período' datatype='datetime' name='[Calculation_199284325334347777]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// mês final dentro do que está filtrado&#13;&#10;DATETRUNC(&#13;&#10;  &apos;month&apos;,&#13;&#10;  { FIXED : MAX( DATE([order_purchase_timestamp (fact_deliveries)]) ) }&#13;&#10;)' />
      </column>
      <column caption='Entrega (dia)' datatype='date' name='[Calculation_199284325346750467]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE( DATETRUNC(&apos;day&apos;, [order_delivered_customer_date (fact_deliveries)]) )' />
      </column>
      <column caption='Estimada (dia)' datatype='date' name='[Calculation_199284325348859908]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE( DATETRUNC(&apos;day&apos;, [order_estimated_delivery_date (fact_deliveries)]) )' />
      </column>
      <column caption='Diferença (dias)' datatype='integer' name='[Calculation_199284325348921349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(&#13;&#10;  ISNULL([Calculation_199284325348859908]) OR ISNULL([Calculation_199284325346750467]),&#13;&#10;  NULL,&#13;&#10;  DATEDIFF(&apos;day&apos;, [Calculation_199284325348859908], [Calculation_199284325346750467])&#13;&#10;)' />
      </column>
      <column caption='Diferença sem negativo' datatype='integer' name='[Calculation_199284325348982790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_199284325348921349] &lt; 0, 0, [Calculation_199284325348921349])' />
      </column>
      <column caption='Atraso do pedido (por pedido)' datatype='integer' name='[Calculation_199284325349060615]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [order_id (fact_deliveries)] :&#13;&#10;    MIN([Calculation_199284325348982790])&#13;&#10;}' />
      </column>
      <column caption='Atraso médio dias' datatype='real' name='[Calculation_199284325349117960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_199284325349060615])' />
      </column>
