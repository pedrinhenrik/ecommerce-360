      <column caption='Alto_Risco' datatype='integer' name='[Calculation_1717278877896445953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [prob_atraso] &gt;= [Parameters].[Parâmetro 1] THEN 1 ELSE 0 END' />
      </column>
      <column caption='% Alto Risco' datatype='real' name='[Calculation_1717278877896941570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1717278877896445953]) / COUNT([order_id])' />
      </column>
      <column caption='Recall' datatype='real' name='[Calculation_1717278877897437187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [y_true] = 1 AND [Calculation_1717278877896445953] = 1 THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [y_true] = 1 THEN 1 ELSE 0 END&#13;&#10;)' />
      </column>
      <column caption='Precision' datatype='real' name='[Calculation_1717278877897752580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_1717278877896445953] = 1 AND [y_true] = 1 THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [Calculation_1717278877896445953] = 1 THEN 1 ELSE 0 END&#13;&#10;)' />
      </column>
      <column caption='Preço + Frete' datatype='real' name='[Calculation_1717278877898768390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[price] + [freight_value]' />
      </column>
      <column caption='Receita em Risco' datatype='real' name='[Calculation_1717278877898899463]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [prob_atraso] &gt;= [Parameters].[Parâmetro 1] THEN [Calculation_1717278877898768390] END' />
      </column>
      <column caption='Receita em Risco Mensal' datatype='real' name='[Calculation_1717278877902921737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [prob_atraso] &gt;= [Parameters].[Parâmetro 1] THEN [Calculation_1717278877898768390] END' />
      </column>
      <column caption='Receita Potencial Perdida' datatype='real' name='[Calculation_1717278877903183882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( [Calculation_1717278877898768390] * [y_true] )' />
      </column>
      <column caption='Taxa de Atraso (%)' datatype='real' name='[Calculation_1717278877918662667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG( INT([y_true]) )' />
      </column>
      <column caption='Receita Atrasada (real)' datatype='real' name='[Calculation_1717278877918994444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [y_true] = 1 THEN [Calculation_1717278877898768390] END' />
      </column>
      <column caption='Receita em Risco (prevista)' datatype='real' name='[Calculation_1717278877919047693]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [prob_atraso] &gt;= [Parameters].[Parâmetro 1] THEN [Calculation_1717278877898768390] END' />
      </column>
      <column caption='Preço + Frete fact_order_items' datatype='real' name='[Calculation_1717278877925875726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[price] + [freight_value]' />
      </column>
      <column caption='Alto Risco (binário)' datatype='integer' name='[Calculation_1717278877926006799]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([prob_atraso] &gt;= 0.05)' />
