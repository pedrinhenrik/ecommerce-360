      <aliases enabled='yes' />
      <column caption='Rank Pior Nota' datatype='integer' name='[Calculation_1735293273663328256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(AVG([review_score]), &apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Order Purchase Date' datatype='date' name='[Calculation_1876593711624228865]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([order_purchase_timestamp])' />
      </column>
      <column caption='Promotor / Neutro / Detrator' datatype='string' name='[Calculation_1876593711625875459]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [review_score] &gt;= 4 THEN &quot;Promotor&quot;&#13;&#10;ELSEIF [review_score] = 3 THEN &quot;Neutro&quot;&#13;&#10;ELSE &quot;Detrator&quot;&#13;&#10;END' />
      </column>
      <column caption='Avaliações Positivas' datatype='integer' name='[Calculation_1876593711626149893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [review_score] &gt;= 4 THEN 1 END)' />
      </column>
      <column caption='Avaliações Negativas' datatype='integer' name='[Calculation_1876593711626223622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [review_score] &lt;= 2 THEN 1 END)' />
      </column>
      <column caption='KPI — Avaliações Positivas' datatype='integer' name='[Calculation_1876593711638847496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [review_score] &gt;= 4 THEN 1 END&#13;&#10;)' />
      </column>
      <column caption='KPI — Avaliações Negativas' datatype='integer' name='[Calculation_1876593711643172873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [review_score] &lt;= 2 THEN 1 END&#13;&#10;)' />
      </column>
      <column caption='NPS Atual' datatype='real' name='[Calculation_1876593711648374797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    (COUNT(IIF([review_score] &gt;= 4, 1, NULL)) -&#13;&#10;     COUNT(IIF([review_score] &lt;= 2, 1, NULL)))&#13;&#10;    / COUNT([review_id])&#13;&#10;) * 100' />
      </column>
      <column caption='Variação do NPS' datatype='real' name='[Calculation_1876593711649275919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1876593711648374797] - [NPS Atual (cópia)_1876593711649144846]) / ABS([NPS Atual (cópia)_1876593711649144846])' />
      </column>
      <column caption='Ano-Mês' datatype='string' name='[Calculation_1876593711650619408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([date_id])) + &quot;-&quot; + RIGHT(&quot;00&quot; + STR(MONTH([date_id])), 2)' />
      </column>
      <column caption='NPS' datatype='real' name='[Calculation_1876593711650738193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    (COUNT(IIF([review_score] &gt;= 4, 1, NULL)) -&#13;&#10;     COUNT(IIF([review_score] &lt;= 2, 1, NULL)))&#13;&#10;    / COUNT([review_id])&#13;&#10;) * 100' />
      </column>
      <column caption='Média da Nota' datatype='real' name='[Calculation_1876593711657259026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([review_score])' />
      </column>
      <column caption='Satisfeito?' datatype='string' name='[Calculation_1876593711665352724]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1876593711657259026] &gt;= 4 THEN &quot;Satisfeito&quot; ELSE &quot;Não satisfeito&quot; END' />
      </column>
      <column caption='Classificação Satisfação' datatype='string' name='[Calculation_1876593711666110485]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// usa a nota individual, convertendo para número se vier como texto&#13;&#10;IF INT([review_score]) &gt;= 4 THEN &quot;Satisfeito&quot;&#13;&#10;ELSEIF INT([review_score]) = 3 THEN &quot;Neutro&quot;&#13;&#10;ELSE &quot;Insatisfeito&quot;&#13;&#10;END' />
      </column>
      <column caption='Pct Avaliações' datatype='real' name='[Calculation_1876593711671193622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([review_id]) / WINDOW_SUM(COUNT([review_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Classificação NPS' datatype='string' name='[Calculation_378865360825294848]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [review_score] &gt;= 4 THEN &quot;Promotor&quot;&#13;&#10;ELSEIF [review_score] = 3 THEN &quot;Neutro&quot;&#13;&#10;ELSE &quot;Detrator&quot;&#13;&#10;END' />
      </column>
      <column caption='NPS 2' datatype='real' name='[Calculation_378865360825614337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM(IIF([Calculation_378865360825294848] = &quot;Promotor&quot;, 1, 0)) -&#13;&#10;SUM(IIF([Calculation_378865360825294848] = &quot;Detrator&quot;, 1, 0))&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([review_id])&#13;&#10;* 100' />
      </column>
      <column caption='Destaque Top 1' datatype='string' name='[Calculation_871446571779637248]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1735293273663328256] = 1 THEN &quot;Top&quot; ELSE &quot;Outros&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank para exibir no texto' datatype='integer' name='[Calculation_871446571804614658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(AVG([review_score]), &quot;asc&quot;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='NPS Anterior' datatype='real' name='[NPS Atual (cópia)_1876593711649144846]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    (COUNT(IIF([review_score] &gt;= 4&#13;&#10;        AND [date_id] &lt; DATEADD(&apos;month&apos;, -3, { FIXED : MAX([date_id]) })&#13;&#10;        AND [date_id] &gt;= DATEADD(&apos;month&apos;, -6, { FIXED : MAX([date_id]) })&#13;&#10;    , 1, NULL))&#13;&#10;    -&#13;&#10;     COUNT(IIF([review_score] &lt;= 2&#13;&#10;        AND [date_id] &lt; DATEADD(&apos;month&apos;, -3, { FIXED : MAX([date_id]) })&#13;&#10;        AND [date_id] &gt;= DATEADD(&apos;month&apos;, -6, { FIXED : MAX([date_id]) })&#13;&#10;    , 1, NULL))&#13;&#10;)&#13;&#10;    / COUNT(IIF([date_id] &lt; DATEADD(&apos;month&apos;, -3, { FIXED : MAX([date_id]) })&#13;&#10;        AND [date_id] &gt;= DATEADD(&apos;month&apos;, -6, { FIXED : MAX([date_id]) })&#13;&#10;    , [review_id], NULL))&#13;&#10;) * 100' />
      </column>
