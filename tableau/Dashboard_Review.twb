    <worksheet name='KPI - Avaliações Negativas'>
      <table>
        <view>
          <datasources>
            <datasource caption='staging_olist_order_reviews (staging_olist.staging_olist_order_reviews)+ (ecommerce_olist)' name='federated.1pgx4l601vih8n13z2ei40oggaap' />
          </datasources>
          <datasource-dependencies datasource='federated.1pgx4l601vih8n13z2ei40oggaap'>
            <column caption='KPI — Avaliações Negativas' datatype='integer' name='[Calculation_1876593711643172873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [review_score] &lt;= 2 THEN 1 END&#13;&#10;)' />
            </column>
            <column caption='Date Id' datatype='date' name='[date_id]' role='dimension' type='ordinal' />
            <column caption='Geolocation State' datatype='string' name='[geolocation_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[date_id]' derivation='None' name='[none:date_id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[geolocation_state]' derivation='None' name='[none:geolocation_state:nk]' pivot='key' type='nominal' />
            <column-instance column='[product_category_name]' derivation='None' name='[none:product_category_name:nk]' pivot='key' type='nominal' />
            <column caption='Product Category Name' datatype='string' name='[product_category_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;alimentos_bebidas&quot;' value='Alimentos e Bebidas' />
                <alias key='&quot;cds_dvds_musicais&quot;' value='CDs, DVDs e Música' />
                <alias key='&quot;construcao_ferramentas_ferramentas&quot;' value='Construção, Ferramentas e Segurança' />
                <alias key='&quot;fashion_roupa_masculina&quot;' value='Roupas Masculinas' />
                <alias key='&quot;flores&quot;' value='Flores' />
                <alias key='&quot;livros_interesse_geral&quot;' value='Livros – Interesse Geral' />
                <alias key='&quot;moveis_escritorio&quot;' value='Móveis para Escritório' />
                <alias key='&quot;pc_gamer&quot;' value='Computador Gamer' />
                <alias key='&quot;portateis_cozinha_e_preparadores_de_alimentos&quot;' value='Aparelhos e Portáteis de Cozinha' />
                <alias key='&quot;seguros_e_servicos&quot;' value='Seguros e Serviços' />
              </aliases>
